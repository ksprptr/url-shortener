          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 201', () => pm.response.to.have.status(201));",
                  "pm.test('responds under 1s', () => pm.expect(pm.response.responseTime).to.be.below(1000));",
                  "const b = pm.response.json();",
                  "pm.test('absolute short url', () => pm.expect(b.shortUrl).to.match(/^https?:\\/\\/.+\\/\\w+$/));",
                  "pm.test('normalizes the target', () => pm.expect(b.targetUrl).to.eql('https://example.com/runtime-test'));",
                  "pm.collectionVariables.set('publicSlug', b.slug);"
                ]
