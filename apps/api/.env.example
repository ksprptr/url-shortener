# App
APP_PORT=4000
NODE_ENV=development

# URLs
WEB_APP_URL=http://localhost:3000

# CORS
CORS_ALLOWED_ORIGINS=http://localhost:4000,http://localhost:3000

# Security
# Leave this unset. The browser only ever talks to the web app, so the auth cookies stay host-only
# on that one origin. Set it (to a parent both hosts share) ONLY if you deliberately publish this
# API on its own host, and know that every sibling subdomain then receives the operator's session.
# COOKIE_DOMAIN=""

# Trusted proxy hops in front of the API (Express `trust proxy`). Optional, defaults to 1. Set to
# match your topology so the rate limiter keys on the real client IP.
# TRUST_PROXY_HOPS=1

# JWT
JWT_ACCESS_SECRET=generate_me_access_secret

# Database (PostgreSQL)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=url_shortener
DB_USER=root
DB_PASS=password

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_USER=default
REDIS_PASS=password
REDIS_KEY_PREFIX=url-shortener:

# Rate limiting
RATE_LIMIT_ENABLED=true

# How many links one IP may shorten from the public form per day.
PUBLIC_LINK_DAILY_LIMIT=5

# Links
# Length of a generated slug. Longer = a larger keyspace and less guessable.
SLUG_LENGTH=7

# Auth — a bcrypt hash of the operator password, never the password itself. Generate one with:
#   pnpm --filter api exec node -e "import('bcryptjs').then((b) => b.hash('your-password', 12)).then(console.log)"
AUTH_PASSWORD=generate_me_bcrypt_hash
