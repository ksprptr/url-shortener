# Test environment for the e2e suite. Prisma is mocked, so DB_*/REDIS_* just satisfy the env
# validation and are never dialed. Values are throwaway — see 08-ci-setup for why this template
# is committed and copied, not rebuilt in CI.
#
# Unquoted, like .env: the API's env is read raw (see the root docker-compose note).

APP_PORT=4000
NODE_ENV=test
WEB_APP_URL=http://localhost:3000
CORS_ALLOWED_ORIGINS=http://localhost:3000
JWT_ACCESS_SECRET=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef
DB_HOST=localhost
DB_PORT=5432
DB_NAME=url_shortener_test
DB_USER=test
DB_PASS=test
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_USER=default
REDIS_PASS=test
REDIS_KEY_PREFIX=url-shortener-test:
# Off in the suite: the smoke tests assert guard/pipe wiring, not throttling (covered by the
# rate-limit unit specs). Leaving it on would make an in-memory limiter's state bleed across tests.
RATE_LIMIT_ENABLED=false
PUBLIC_LINK_DAILY_LIMIT=5
SLUG_LENGTH=7
AUTH_PASSWORD=$2b$04$EFUjz0PEjv.7XzpIuDyYEueOSEcmDwXL.6.ldkOc0AkvRr5.cBYw6
