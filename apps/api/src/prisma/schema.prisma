// Prisma schema for the URL shortener.
// Docs: https://pris.ly/d/prisma-schema

generator client {
  provider     = "prisma-client"
  output       = "./generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

//
// Enums
//

/// Where a link came from. Public links are rate limited per IP; admin links are not.
enum LinkSource {
  PUBLIC
  ADMIN

  @@map("link_source")
}

//
// Models
//

/// Single-row store for the operator's token version. Stateless JWTs are otherwise
/// irrevocable; bumping this version on logout invalidates every access token issued
/// before it (the AuthGuard rejects a token whose `ver` no longer matches).
model AuthState {
  id           String   @id @default("singleton")
  tokenVersion Int      @default(0) @map("token_version")
  updatedAt    DateTime @updatedAt @map("updated_at")

  @@map("auth_state")
}

/// One row per issued refresh token, rotated on every refresh. The token itself is an opaque random
/// secret; only its SHA-256 hash (`tokenHash`) is stored, so a DB leak never exposes usable tokens.
/// Presenting a token whose row is already revoked signals reuse (theft) → full session revocation.
/// `expiresAt` is the sliding idle window; `sessionExpiresAt` is the absolute cap inherited across
/// rotations so a session can't outlive `login + absolute TTL`. Expired rows are pruned on refresh.
model RefreshToken {
  id                String    @id @default(uuid())
  tokenHash         String    @unique @map("token_hash")
  subject           String
  revokedAt         DateTime? @map("revoked_at")
  replacedByTokenId String?   @map("replaced_by_token_id")
  expiresAt         DateTime  @map("expires_at")
  sessionExpiresAt  DateTime  @map("session_expires_at")
  createdAt         DateTime  @default(now()) @map("created_at")

  @@index([subject], map: "idx_refresh_token_subject")
  @@index([expiresAt], map: "idx_refresh_token_expires_at")
  @@map("refresh_tokens")
}

/// A short link. `slug` is the path segment the visitor hits; it is the lookup key on the hot
/// redirect path, so it is unique and indexed. Nothing about the visitor is stored — only the
/// aggregate `clickCount` / `lastVisitedAt` on the link itself and the per-day totals below.
model Link {
  id            String     @id @default(uuid())
  slug          String     @unique
  targetUrl     String     @map("target_url")
  /// Admin-only label; never shown to visitors.
  note          String?
  /// Null = never expires.
  expiresAt     DateTime?  @map("expires_at")
  /// Set = manually taken offline by the operator, independently of `expiresAt`.
  disabledAt    DateTime?  @map("disabled_at")
  clickCount    Int        @default(0) @map("click_count")
  lastVisitedAt DateTime?  @map("last_visited_at")
  source        LinkSource @default(PUBLIC)
  /// SHA-256 of the creator's IP, salted per day — the public daily quota counts these rows
  /// instead of keeping addresses. Null for admin-created links.
  creatorHash   String?    @map("creator_hash")
  createdAt     DateTime   @default(now()) @map("created_at")
  updatedAt     DateTime   @updatedAt @map("updated_at")

  dailyStats LinkDailyStat[]

  @@index([createdAt], map: "idx_link_created_at")
  @@index([expiresAt], map: "idx_link_expires_at")
  @@index([creatorHash, createdAt], map: "idx_link_creator_hash_created_at")
  @@map("links")
}

/// Per-day click totals, the only visit history the app keeps. A counter per (link, UTC day)
/// carries the admin dashboard chart without ever recording who followed a link or from where.
model LinkDailyStat {
  id     String   @id @default(uuid())
  linkId String   @map("link_id")
  /// UTC midnight of the day being counted.
  date   DateTime @db.Date
  clicks Int      @default(0)

  link Link @relation(fields: [linkId], references: [id], onDelete: Cascade)

  @@unique([linkId, date])
  @@index([date], map: "idx_link_daily_stat_date")
  @@map("link_daily_stats")
}
