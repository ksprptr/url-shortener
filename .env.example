# Root environment — infrastructure + the web app (docker compose reads this file).
# The API's own secrets live in apps/api/.env (see apps/api/.env.example).
#
#   cp .env.example .env

# Database (PostgreSQL)
# No DB_HOST here: inside the compose network the API always talks to the `url-shortener-pg` container.
DB_PORT=5432
DB_NAME="url_shortener"
DB_USER="root"
DB_PASS="password"

# Redis (rate limiter)
REDIS_PORT=6379
REDIS_USER="default"
REDIS_PASS="password"
REDIS_KEY_PREFIX="url-shortener:"

# URLs
# Public origin of the web app. Every short link is built from it, and it is baked into the
# prerendered SEO metadata at build time — keep the build arg and the runtime value identical.
APP_URL="http://localhost:3000"

# Security
# Auth-cookie domain. In production this is the web app's own host (the API is only reachable
# over the compose network); use a shared parent only if you publish the API separately.
COOKIE_DOMAIN="localhost"

# Host port the web app publishes on, bound to 127.0.0.1 (docker compose only). The API is not
# published — it is reached only over the compose network.
WEB_PORT=3000
